  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "pg": "^8.22.0",
    "ws": "^8.21.2"
  }
}
