{
  "name": "web-game-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/stamp-sw.mjs",
    "build:static": "tsc && vite build --mode static && node scripts/stamp-sw.mjs",
    "build:online": "tsc && vite build --mode online && node scripts/stamp-sw.mjs",
    "preview": "vite preview",
    "test": "node scripts/smoke.mjs",
    "test:unit": "node --experimental-strip-types scripts/unit-test.mjs",
    "test:academy": "node --experimental-strip-types scripts/team-academy-audit.mjs",
    "audit": "node scripts/audit.mjs",
    "content-audit": "node --experimental-strip-types scripts/content-audit.mjs",
    "leadership-audit": "node --experimental-strip-types scripts/leadership-audit.mjs",
    "role-audit": "node --experimental-strip-types scripts/role-audit.mjs",
    "ability-balance": "node --experimental-strip-types scripts/ability-balance.mjs",
    "save-roundtrip": "node --experimental-strip-types scripts/save-roundtrip.mjs",
    "balance-sim": "node --experimental-strip-types scripts/balance-sim.mjs",
    "coach:export": "node --experimental-strip-types scripts/coach-export.mjs",
    "deploy:check": "node scripts/deploy-check.mjs",
    "generate:art": "node scripts/generate-chapter-art.mjs",
    "generate:real-art": "node scripts/generate-real-art.mjs",
    "i18n-audit": "node --experimental-strip-types scripts/i18n-audit.mjs",
    "test:i18n-browser": "node --experimental-strip-types scripts/i18n-browser-audit.mjs",
    "test:device-screenshots": "node --experimental-strip-types scripts/device-audit.mjs",
    "test:features": "node scripts/feature-audit.mjs",
    "test:music": "node scripts/music-audit.mjs",
    "test:coach-hints": "node --experimental-strip-types scripts/coach-hint-audit.mjs",
    "test:system": "node --experimental-strip-types scripts/system-audit.mjs",
    "test:accessibility": "node --experimental-strip-types scripts/accessibility-audit.mjs",
    "test:rtc": "node --experimental-strip-types scripts/rtc-audit.mjs",
    "test:role-campaign": "node scripts/role-campaign-audit.mjs",
    "test:role-campaign-sim": "node --experimental-strip-types scripts/role-campaign-sim.mjs",
    "server": "node server/index.mjs",
    "test:server": "node scripts/server-smoke.mjs",
    "test:server-edge": "node scripts/server-edge.mjs",
    "test:live": "node scripts/live-audit.mjs",
    "test:rtc:public": "node --experimental-strip-types scripts/public-rtc-audit.mjs",
    "recovery:github": "node scripts/github-recovery.mjs"
